{
	"permissions": {
		"deny": [
			"Read(.env)",
			"Read(.env.*)",
			"Read(./.env)",
			"Read(./.env.*)",
			"Bash(git push --force*)",
			"Bash(git push -f*)",
			"Bash(git reset --hard*)",
			"Bash(git clean*)"
		]
	},
	"hooks": {
		"PostToolUse": [
			{
				"matcher": "Edit|Write",
				"hooks": [
					{
						"type": "command",
						"command": "composer lint && composer phpcs"
					}
				]
			}
		]
	}
}
