<?xml version="1.0"?>
<ruleset name="Gravity Forms TOPS">
	<description>WordPress security, database, i18n and PHP 7.4 compatibility checks for the Gravity Forms TOPS plugin.</description>

	<file>.</file>
	<exclude-pattern>/vendor/*</exclude-pattern>
	<exclude-pattern>/build/*</exclude-pattern>
	<exclude-pattern>/node_modules/*</exclude-pattern>
	<!-- Test doubles intentionally stub WordPress / Gravity Forms globals. -->
	<exclude-pattern>/tests/*</exclude-pattern>
	<exclude-pattern>/bin/*</exclude-pattern>

	<arg name="extensions" value="php"/>
	<arg name="colors"/>
	<arg value="sp"/>

	<config name="testVersion" value="7.4-"/>
	<config name="minimum_wp_version" value="6.2"/>

	<rule ref="PHPCompatibilityWP"/>

	<!--
		WordPress-Extra keeps the security (escaping, nonces, sanitization), prepared-SQL,
		i18n and WP API sniffs. Whitespace-alignment and naming style rules are excluded
		because the existing code predates them; enabling them is a separate formatting change.
	-->
	<rule ref="WordPress-Extra">
		<exclude name="WordPress.PHP.YodaConditions"/>
		<exclude name="WordPress.Arrays.MultipleStatementAlignment"/>
		<exclude name="WordPress.Arrays.ArrayDeclarationSpacing"/>
		<exclude name="Generic.Formatting.MultipleStatementAlignment"/>
		<exclude name="Generic.Files.LineEndings"/>
		<exclude name="Universal.Operators.DisallowShortTernary"/>
		<!-- GFAddOn requires $_version, $_slug, etc. -->
		<exclude name="PSR2.Classes.PropertyDeclaration.Underscore"/>
		<exclude name="WordPress.NamingConventions.ValidVariableName.UsedPropertyNotSnakeCase"/>
	</rule>

	<rule ref="WordPress.WP.I18n">
		<properties>
			<property name="text_domain" type="array">
				<element value="gravity-forms-tops"/>
			</property>
		</properties>
	</rule>

	<rule ref="WordPress.WP.Capabilities">
		<properties>
			<property name="custom_capabilities" type="array">
				<element value="gform_full_access"/>
				<element value="gravityforms_edit_forms"/>
				<element value="gravityforms_view_entries"/>
				<element value="gravityforms_edit_entries"/>
			</property>
		</properties>
	</rule>
</ruleset>
